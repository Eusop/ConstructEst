# Copy this file to .env and fill in your own key — .env is gitignored so
# it never gets committed.

# Google Maps JavaScript API key, used by the Store Locator page's map.
# Create one at https://console.cloud.google.com/google/maps-apis and make
# sure the "Maps JavaScript API" is enabled for it.
VITE_GOOGLE_MAPS_API_KEY=

# Base URL of the ConstructEst backend (see ../backend). Defaults to
# http://localhost:4000/api if unset.
VITE_API_URL=http://localhost:4000/api
