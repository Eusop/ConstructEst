# ------------------------------------------------------------
# ConstructEst frontend — environment template
# Copy to .env and fill in. NEVER commit .env.
# ------------------------------------------------------------

# Base URL of the ConstructEst backend (see ../backend/README.md).
# Defaults to http://localhost:4000/api if unset, so this line is only
# needed when the backend runs somewhere else (a different port, or the
# deployed Railway URL for a build pointed at production).
VITE_API_URL=http://localhost:4000/api
