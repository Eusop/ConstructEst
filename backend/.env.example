# ------------------------------------------------------------
# ConstructEst backend — environment template
# Copy to .env and fill in. NEVER commit .env.
# ------------------------------------------------------------

PORT=4000

# ---- MySQL (XAMPP defaults) ---------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=constructest

# ---- Auth -----------------------------------------------------
# A long random string. Anyone who knows it can mint a valid login token.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- DXF engine -------------------------------------------------
# Path to the Python interpreter that has ezdxf installed:
#   pip install -r engine/requirements.txt
# then point this at that same interpreter (`which python` / `where python`).
# Without a working interpreter here, every DXF upload fails at parse time.
PYTHON_BIN=python

# Max DXF upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# Max avatar image upload size in bytes (default 2 MB).
MAX_AVATAR_BYTES=2097152

# How long the Node backend waits for the Python engine subprocess before
# killing it and reporting a timeout (default 60000 = 60s). The largest
# sample DXF (a merged two-floor file, ~370KB) parses in under 1 second, so
# this default has a wide margin; raise it only if a real project's DXF is
# unusually large or complex.
ENGINE_TIMEOUT_MS=60000

# ---- CORS -------------------------------------------------------
# Frontend origin. Must match exactly (scheme + host + port).
CORS_ORIGIN=http://localhost:5173

# ---- Email (Brevo HTTP API) --------------------------------------
# Used for the 6-digit email-verification code and password-reset emails
# (src/services/mailer.service.js). Get a free API key from
# https://app.brevo.com/settings/keys/api. BREVO_FROM_EMAIL must be exactly
# the address verified under Senders, Domains & Dedicated IPs > Senders >
# Single Sender — Brevo rejects any other "from" address.
# Without real values here, registration correctly fails fast with an
# explanatory error instead of silently creating an unverifiable account —
# that's expected on a fresh clone, not a bug.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=youraccount@gmail.com
BREVO_FROM_NAME=ConstructEst

# ---- Pricing assumptions ------------------------------------------
# Scaffolding is bought new at retail but reused across projects (no local
# rental rate exists — see docs/paper-limitations.md entry 3). The BOM
# divides the retail price by this many assumed uses. Default 10 if unset;
# this figure is the team's own assumption, not domain-expert-validated.
SCAFFOLDING_REUSE_COUNT=10
