# Copy to .env and fill in — .env is gitignored.

PORT=4000

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=constructest

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to the Python interpreter that has ezdxf installed (see engine/requirements.txt)
PYTHON_BIN=python

# Max DXF upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Frontend origin, for CORS
CORS_ORIGIN=http://localhost:5173

# Gmail SMTP for the 6-digit email-verification code (see
# src/services/mailer.service.js). GMAIL_USER is a personal Gmail address
# with 2-Step Verification on; GMAIL_APP_PASSWORD is the 16-character App
# Password generated for it (Google Account > Security > App passwords) —
# NOT the normal account password, which Gmail SMTP rejects outright.
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
