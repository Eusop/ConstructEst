# Copy to .env and fill in — .env is gitignored.

PORT=4000

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=constructest
# Set to "true" for a hosted MySQL that requires TLS (TiDB Cloud, Aiven, …).
# Leave blank for a local/XAMPP database.
DB_SSL=

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to the Python interpreter that has ezdxf installed (see engine/requirements.txt)
PYTHON_BIN=python

# Max DXF upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Frontend origin, for CORS
CORS_ORIGIN=http://localhost:5173
