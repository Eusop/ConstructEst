# Copy to .env and fill in — .env is gitignored.

PORT=4000

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=constructest

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to the Python interpreter that has ezdxf installed (see engine/requirements.txt)
PYTHON_BIN=python

# Max DXF upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Frontend origin, for CORS
CORS_ORIGIN=http://localhost:5173

# Resend HTTP API for the 6-digit email-verification code and password-reset
# emails (see src/services/mailer.service.js). Get an API key from
# https://resend.com/api-keys. RESEND_FROM_ADDRESS is optional — it defaults
# to Resend's shared sandbox sender, which only works for testing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=ConstructEst <onboarding@resend.dev>
